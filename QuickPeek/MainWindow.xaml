<Window x:Class="QuickPeek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPeek 设置"
        Height="880" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <!-- WPF 默认 ComboBox 模板把背景色写死成浅灰，改 Background 无效，
             这里换成跟随 Background/Foreground 的简洁模板，深色模式才能生效 -->
        <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="8,3,24,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Focusable="False">
                                <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleTextBlock" Text="QuickPeek" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="SubtitleTextBlock" Text="资源管理器文件悬停预览" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="常规" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="EnabledCheckBox" Grid.Row="0" Grid.Column="0" Content="启用 QuickPeek" Margin="0,4,0,4"/>
                        <CheckBox x:Name="DarkThemeCheckBox" Grid.Row="0" Grid.Column="1" Content="深色模式" Margin="0,4,0,4"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="设置页缩放" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="UiScaleTextBox" Width="56" VerticalAlignment="Center"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="浮窗文字缩放" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="PreviewScaleTextBox" Width="56" VerticalAlignment="Center"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <CheckBox x:Name="AutoStartCheckBox" Grid.Row="2" Grid.Column="0" Content="开机自启动" Margin="0,4,0,4"/>
                        <CheckBox x:Name="StartMinimizedCheckBox" Grid.Row="2" Grid.Column="1" Content="启动时最小化" Margin="0,4,0,4"/>

                        <CheckBox x:Name="BlankDoubleClickCheckBox" Grid.Row="3" Grid.Column="0"
                                  Content="空白区域双击返回上一层" Margin="0,4,0,4"/>

                        <CheckBox x:Name="ShowFileInfoCheckBox" Grid.Row="3" Grid.Column="1"
                                  Content="显示详细信息" Margin="0,4,0,4"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="窗口" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="位置" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CornerComboBox" Width="120" Style="{StaticResource ThemedComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="悬停延迟" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="HoverDelayTextBox" Width="56" VerticalAlignment="Center"/>
                            <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="大小" VerticalAlignment="Center" Width="60"/>
                            <TextBlock Text="宽" VerticalAlignment="Center"/>
                            <TextBox x:Name="WidthTextBox" Width="60" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="高" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <TextBox x:Name="HeightTextBox" Width="60" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="边距" VerticalAlignment="Center" Width="60"/>
                            <TextBlock Text="宽" VerticalAlignment="Center"/>
                            <TextBox x:Name="MarginXTextBox" Width="60" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="高" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <TextBox x:Name="MarginYTextBox" Width="60" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="窗口透明度" VerticalAlignment="Center" Width="90"/>
                            <Slider x:Name="WindowOpacitySlider" Width="200" Minimum="0.2" Maximum="1.0" Value="0.95" VerticalAlignment="Center"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="WindowOpacityValueText" Width="48" VerticalAlignment="Center" Margin="8,0,0,0" Text="95%"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="内容透明度" VerticalAlignment="Center" Width="90"/>
                            <Slider x:Name="ContentOpacitySlider" Width="200" Minimum="0.2" Maximum="1.0" Value="1.0" VerticalAlignment="Center"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="ContentOpacityValueText" Width="48" VerticalAlignment="Center" Margin="8,0,0,0" Text="100%"/>
                        </StackPanel>

                        <RadioButton x:Name="SizeModeMaxRatioRadio" Grid.Row="5" Grid.Column="0" Content="原图比例最大化" Margin="0,4,0,4" IsChecked="True"/>
                        <RadioButton x:Name="SizeModeFitRadio" Grid.Row="5" Grid.Column="1" Content="全尺寸填充窗口" Margin="0,4,0,4"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="预览" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="ShowImagesCheckBox" Grid.Row="0" Grid.Column="0" Content="图片" Margin="0,4,0,4"/>
                        <CheckBox x:Name="ShowVideosCheckBox" Grid.Row="0" Grid.Column="1" Content="视频" Margin="0,4,0,4"/>
                        <CheckBox x:Name="ShowAudiosCheckBox" Grid.Row="0" Grid.Column="2" Content="音频" Margin="0,4,0,4"/>

                        <CheckBox x:Name="ShowTextsCheckBox" Grid.Row="1" Grid.Column="0" Content="文本" Margin="0,4,0,4"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="最大文本大小" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="MaxTextSizeTextBox" Width="56" VerticalAlignment="Center"/>
                            <TextBlock Text="KB" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="默认音量" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="DefaultVolumeTextBox" Width="48" VerticalAlignment="Center"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="默认播放速度" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="DefaultSpeedTextBox" Width="48" VerticalAlignment="Center"/>
                            <TextBlock Text="倍" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="音量步进" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="VolumeStepTextBox" Width="48" VerticalAlignment="Center"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="快进快退" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SeekStepTextBox" Width="48" VerticalAlignment="Center"/>
                            <TextBlock Text="秒" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="加减速" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SpeedStepTextBox" Width="48" VerticalAlignment="Center"/>
                            <TextBlock Text="倍" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="快捷键" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="CtrlWheelVolumeCheckBox" Grid.Row="0" Grid.Column="0" Content="Ctrl+滚轮上下：调节音量" Margin="0,4,0,4"/>
                        <CheckBox x:Name="CtrlWheelSeekCheckBox" Grid.Row="0" Grid.Column="1" Content="Ctrl+滚轮左右：快进快退" Margin="0,4,0,4"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="音量+" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="VolumeUpHotkeyTextBox" Width="110" Height="26" VerticalAlignment="Center"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="音量-" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="VolumeDownHotkeyTextBox" Width="110" Height="26" VerticalAlignment="Center"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="快进" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="StepFwdHotkeyTextBox" Width="110" Height="26" VerticalAlignment="Center"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="快退" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="StepBackHotkeyTextBox" Width="110" Height="26" VerticalAlignment="Center"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="加速" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SpeedUpHotkeyTextBox" Width="110" Height="26" VerticalAlignment="Center"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="减速" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SpeedDownHotkeyTextBox" Width="110" Height="26" VerticalAlignment="Center"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ResetButton" Content="恢复默认" Width="100" Height="32" Margin="0,0,8,0" Click="ResetButton_Click" Style="{StaticResource QP.Button}"/>
            <Button x:Name="ApplyButton" Content="应用" Width="100" Height="32" Margin="0,0,8,0" Click="ApplyButton_Click" Style="{StaticResource QP.Button}"/>
            <Button x:Name="SaveButton" Content="保存" Width="100" Height="32" Click="SaveButton_Click" Style="{StaticResource QP.Button}"/>
        </StackPanel>
    </Grid>
</Window>

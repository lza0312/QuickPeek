<Window x:Class="QuickPeek.Preview.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        Title="QuickPeek Video"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#FF101010"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        SourceInitialized="Window_SourceInitialized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 文件信息集中在顶部标题栏，不显示信息时整条隐藏 -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Height="44" Background="#FF2D2D2D" Padding="12,6">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="FileNameTextBlock"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="HeaderInfoTextBlock"
                           Foreground="#FF8A8A8A"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- FlyleafHost 会用独立 Surface 窗口渲染视频，因此宿主窗口必须是不透明的 -->
        <fl:FlyleafHost x:Name="Host"
                        Grid.Row="1"
                        VideoBackground="#FF000000"
                        KeepRatioOnResize="True"
                        ActivityTimeout="0"/>
    </Grid>
</Window>

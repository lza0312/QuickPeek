<Window x:Class="QuickPeek.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPeek"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border x:Name="Root"
            Margin="16"
            Background="{DynamicResource QP.Panel}"
            BorderBrush="{DynamicResource QP.Border}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20,18"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="BrandTextBlock" Text="QuickPeek" Foreground="{DynamicResource QP.SubText}" FontSize="12" />
            <TextBlock x:Name="MessageText"
                       Foreground="{DynamicResource QP.Text}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,6,0,18" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Width="84"
                        Height="30"
                        Margin="0,0,8,0"
                        Style="{StaticResource QP.Button}"
                        Background="{DynamicResource QP.ButtonBg}"
                        Foreground="{DynamicResource QP.Text}" />
                <Button x:Name="OkButton"
                        Content="确定"
                        Width="84"
                        Height="30"
                        Style="{StaticResource QP.Button}"
                        Background="{DynamicResource QP.Accent}"
                        Foreground="White" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
